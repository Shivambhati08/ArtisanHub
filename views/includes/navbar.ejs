<style>
  .search-btn{
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem;

  }
  .search-btn:hover{
    background-color: #fe424d;
    color: #fff;
  }
  .search-btn i{
    display: inline;
    margin-right: 0.5rem;
  }
  .search-inp{
    border-radius: 25px;
    padding: 0.5rem 3rem;
  }
  .navbar {
    background-color: white;
}
    .add-art-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #222 !important;
    text-decoration: none;
    font-weight: 500;
    margin-right: 1rem;
}

.add-art-link i {
    font-size: 1.2rem;
    margin-bottom: 4px;
}

.add-art-link:hover {
    color: #fe424d !important;
}
.profile-nav-img{
    width:42px;
    height:42px;
    border-radius:50%;
    object-fit:cover;
    border:2px solid #ddd;
    transition:.3s;
}

.profile-nav-img:hover{
    border-color:#fe424d;
}

@media (max-width: 768px) {

    .navbar-collapse {
        background: white;
        margin-top: 10px;
        padding: 1rem;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

    .navbar-nav {
        gap: 10px;
    }

    .navbar-nav .nav-link {
        padding: 10px 0;
        font-weight: 500;
    }

}
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/services"><img class="photo" src="/images/logo.png" alt="logo"></i></a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/services">Explore</a>
      </div>
      <div class="navbar-nav ms-auto">
        <form class="d-flex" role="search" action="/services/search" method="GET">
  <input
    class="form-control me-2 search-inp"
    type="search"
    name="q"
    placeholder="Search services"
    aria-label="Search"
  />
  <button class="btn search-btn" type="submit">
    <i class="fa-solid fa-magnifying-glass"></i>
    Search
  </button>
</form>
      </div>
       <div class="navbar-nav ms-auto">

       <a class="nav-link add-art-link text-center" href="/services/new">
    <i class="fa-solid fa-circle-plus"></i>
    <span>Add your art</span>
</a>


        <% if(!locals.currUser){ %>
        <a class="nav-link" href="/signup"><b>Sign up</b></a>
        <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } %>
       <% if(locals.currUser){ %>

<div class="dropdown">

 <a
class="nav-link dropdown-toggle d-flex align-items-center"
href="#"
role="button"
data-bs-toggle="dropdown">

<img
src="<%= locals.currUser.profileImage.url %>"
class="profile-nav-img me-2">

<span><%= locals.currUser.username %></span>

</a>

  <ul class="dropdown-menu dropdown-menu-end">

    <li>
      <a class="dropdown-item" href="/profile">
        <i class="fa-solid fa-user"></i>
        My Profile
      </a>
    </li>

    <li>
      <a class="dropdown-item" href="/profile/posts">
        <i class="fa-solid fa-briefcase"></i>
        My Services
      </a>
    </li>

    <li>
      <a class="dropdown-item" href="/profile/favorites">
        <i class="fa-solid fa-heart"></i>
        Favorites
      </a>
    </li>

    <li>
      <a class="dropdown-item" href="/profile/edit">
        <i class="fa-solid fa-user-pen"></i>
        Edit Profile
      </a>
    </li>

    <li><hr class="dropdown-divider"></li>

    <li>
      <a class="dropdown-item text-danger" href="/logout">
        <i class="fa-solid fa-right-from-bracket"></i>
        Log Out
      </a>
    </li>

  </ul>

</div>

<% } %>
      </div>
    </div>
  </div>
</nav>
