<% layout("/layouts/boilerplate") %>
<style>
  .show-img{
    width: 100%;
    max-width: 600px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 20px;
    display: block;
    margin: auto;
}
#map{
    width:100%;
    height:450px;
    border-radius:20px;
    overflow:hidden;
    margin-top:15px;
}

@media (max-width:768px){
    #map{
        height:300px;
    }
}
</style>
<div class="row mt-3">
  <div class="col-12 col-md-8 mx-auto">
    <h3 class="mb-3 text-center text-md-start"><%= service.title %></h3>
  </div>
  <div class="col-12 col-md-8 col-lg-6 mx-auto service-card">
    <div class="card border-0">
      <img
        src="<%= service.image.url %>"
        class="card-img-top show-img"
        alt="..."
      />
      <div class="card-body">
        <p class="card-text">Owned By - 

<a
href="/profile/user/<%= service.owner._id %>"
class="text-decoration-none fw-bold">

<%= service.owner.username %>

</a> </p>
         <p> <%= service.description %> </p>
          <p class="text-danger mb-0">&#8377;<%= service.price.toLocaleString("en-IN") %></p>
          <%= service.location %> <br />
          <%= service.country %> <br />
        </p>
      </div>
      <% if (currUser) { %>
<form action="/profile/favorites/<%= service._id %>" method="POST" class="mb-3">
    <button class="btn btn-outline-danger">
        <i class="fa-solid fa-heart"></i> Add to Favorites
    </button>
</form>
<% } %>
    </div>
  </div>

 <% if(currUser && currUser._id.equals(service.owner._id)){ %>

<div class="col-12 col-md-8 mx-auto mb-4">
    <div class="d-flex gap-2">

        <a href="/services/<%= service._id %>/edit"
           class="btn btn-dark">
            Edit
        </a>

        <form action="/services/<%= service._id %>?_method=DELETE"
              method="POST">

            <button class="btn btn-danger">
                Delete
            </button>

        </form>
    </div>
</div>
<% } %>
  <div class="col-12 col-md-8 mx-auto mb-3">
    <hr />
    <% if(currUser) { %>
    <h4>Leave a Review</h4>
    <form action="/services/<%= service.id %>/reviews" method="post" novalidate class="needs-validation">
      <!--
       
        <input
          type="range"
          min="1"
          max="5"
          id="rating"
          name="review[rating]"
          class="form-range"
        />
      </div> -->
       <div class="mb-3 mt-7">
       <label for="rating" class="form-label">Rating</label>
      <fieldset class="starability-slot">
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
</div>
      <div class="mb-3 mt-7">
        <label for="comment" class="form-label">Comments</label>
        <textarea
          name="review[comment]"
          id="comment"
          cols="30"
          rows="5"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Write some comments for feedback</div>
      </div>
      <button class="btn btn-outline-primary">add review</button>
    </form>
    <% } %>
    <hr>

    <% if(service.reviews.length > 0) { %>
    <div class="row">
      <p><b>All Reviews</b></p>
    <% for(review of service.reviews){ %>
    <div class="card col-12 col-md-5 mb-3 me-md-3">
      <div class="card-body">
        <h5 class="card-title">
        @<%= review.author ? review.author.username : "Anonymous" %>
        </h5>
          <p class="starability-result card-text" data-rating="<%= review.rating %>"></p> 
        <p class="card-text"><%= review.comment %></p>
        <!-- <p class="card-text"> stars</p> -->
      
        <form class="mb-2" action="/services/<%= service._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
          <button class="btn btn-sm btn-outline-danger ">Delete</button>
        </form>
      </div>
    </div>
      <% } %>
  </div>
  <% } %>
  </div>
  <div class="col-12 col-md-8 mx-auto mb-4">
    <h3>Where you'll be</h3>
    <div id="map"></div>
  </div>
</div>



<script>
    // Create map centered on Greater Noida
    const map = L.map("map").setView([28.4744, 77.5040], 13);

    // Add OpenStreetMap tiles
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: "&copy; OpenStreetMap contributors"
    }).addTo(map);

    // Add marker
    L.marker([28.4744, 77.5040])
        .addTo(map)
        .bindPopup("<b>Greater Noida</b>")
        .openPopup();
</script>